# Credential-free example. Never commit the populated .env or host secrets.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Live AI is OFF by default. Enabling it requires an explicit HOST environment
# variable LEAKPROBE_ENABLE_LIVE_AI=1 and LEAKPROBE_DEMO_MODE=0.
# Setting an API key alone never enables requests. Do not enable it for public demos.
